    <qresource prefix="/icons">
        <file alias="user">ui/assets/icons/user.png</file>
        <file alias="search">ui/assets/icons/search.png</file>
    </qresource>
    <qresource prefix="/styles">
        <file alias="global">ui/assets/styles/global.qss</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="raleway-regular">ui/assets/fonts/raleway/Raleway-Regular.ttf</file>
        <file alias="raleway-bold">ui/assets/fonts/raleway/Raleway-Bold.ttf</file>
    </qresource>
</RCC>
